### 3.4 常驻托管脚本（一次写好，从此不靠 nohup 命令）★强推

为什么需要这一步：**只用 `nohup` 挡不住关终端**——切/关一个终端窗口，core/mock/proxy 就会集体消失（本机首装实测踩过，根因和为什么不走 systemd 见「补充 §8b」）。这一节把三件套 `setsid + </dev/null + disown` 收进三个脚本，从此启停用脚本，不再手敲 nohup。

**Step 1：明确脚本写入目录 —— `~/.tdai-lab/`**

三份脚本统一放在 `~/.tdai-lab/`，跟配置、密钥、数据同目录，可整目录删（`rm -rf ~/.tdai-lab` = 一切归零，主 CC 零残留）。

```sh
ls ~/.tdai-lab/    # 应已存在（0.5 建过）；否则 mkdir -p ~/.tdai-lab
```

**Step 2：写 `~/.tdai-lab/start-all.sh`**（拉起 core → mock → proxy，幂等）

```sh
cat > ~/.tdai-lab/start-all.sh <<'SH'
#!/usr/bin/env bash
# 拉起 TencentDB Agent Memory 三件套（core + mock + proxy）
# 幂等：已在跑的服务不会重复启动；会写 pid 到 ~/.tdai-lab/*.pid
set -u

TDAI_HOME="$HOME/.tdai-lab"
REPO="$HOME/workspace/install/TencentDB-Agent-Memory"

# ── nvm & node 22（proxy 硬卡 v22.x）──
export NVM_DIR="$HOME/.nvm"
# shellcheck disable=SC1091
. "$NVM_DIR/nvm.sh" >/dev/null
nvm use 22 >/dev/null || { echo "❌ nvm use 22 失败"; exit 1; }
echo "node=$(node -v)"

is_running() {
  local pidfile="$1"
  [[ -s "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

start_core() {
  if is_running "$TDAI_HOME/core.pid"; then
    echo "✓ core 已在跑 (pid=$(cat "$TDAI_HOME/core.pid"))"
    return
  fi
  echo "→ 启动 core (:8420)"
  cd "$REPO/MemoryCore" || exit 1
  setsid nohup env TDAI_GATEWAY_CONFIG="$TDAI_HOME/tdai-gateway.yaml" \
    npx tsx src/gateway/server.ts >> "$TDAI_HOME/memory-core.log" 2>&1 </dev/null &
  disown
  sleep 5
  # 拿真实 pid（tsx 会 spawn 子进程；抓 --import tsx/esm 之外的 gateway/server 主进程）
  pgrep -af "tsx.*gateway/server.ts" | awk 'NR==1{print $1}' > "$TDAI_HOME/core.pid"
  local code
  code=$(curl -sS -o /dev/null -w "%{http_code}" --max-time 3 http://127.0.0.1:8420/health || echo 000)
  echo "  core pid=$(cat "$TDAI_HOME/core.pid") health=$code"
}

start_mock() {
  if is_running "$TDAI_HOME/mock.pid"; then
    echo "✓ mock 已在跑 (pid=$(cat "$TDAI_HOME/mock.pid"))"
    return
  fi
  [[ -f "$TDAI_HOME/mock-upstream.mjs" ]] || { echo "⚠ mock-upstream.mjs 不存在，跳过（若上游已切 ducky 属正常）"; return; }
  echo "→ 启动 mock (:8199)"
  setsid nohup node "$TDAI_HOME/mock-upstream.mjs" >> "$TDAI_HOME/mock.log" 2>&1 </dev/null &
  disown
  sleep 1
  pgrep -af "mock-upstream.mjs" | awk 'NR==1{print $1}' > "$TDAI_HOME/mock.pid"
  echo "  mock pid=$(cat "$TDAI_HOME/mock.pid")"
}

start_proxy() {
  if is_running "$TDAI_HOME/proxy.pid"; then
    echo "✓ proxy 已在跑 (pid=$(cat "$TDAI_HOME/proxy.pid"))"
    return
  fi
  echo "→ 启动 proxy (:8096)"
  cd "$REPO/MemoryProxy" || exit 1
  setsid nohup node --import tsx/esm src/index.ts --config "$TDAI_HOME/proxy.yaml" \
    >> "$TDAI_HOME/proxy.log" 2>&1 </dev/null &
  disown
  sleep 4
  pgrep -af "node.*--import tsx/esm.*src/index.ts.*proxy.yaml" | awk 'NR==1{print $1}' > "$TDAI_HOME/proxy.pid"
  echo "  proxy pid=$(cat "$TDAI_HOME/proxy.pid")"
}

start_core
start_mock
start_proxy
echo
echo "─── 快速健康 ───"
curl -sS -o /dev/null -w "core=%{http_code}\n" --max-time 3 http://127.0.0.1:8420/health
curl -sS -o /dev/null -w "proxy=%{http_code}\n" --max-time 3 http://127.0.0.1:8096/ 2>/dev/null || echo "proxy 无根路由 = 404 正常"
SH
chmod +x ~/.tdai-lab/start-all.sh
```

**Step 3：写 `~/.tdai-lab/stop-all.sh`**（按 pid 逐个杀，找不到 pid 就用 pgrep 兜底）

```sh
cat > ~/.tdai-lab/stop-all.sh <<'SH'
#!/usr/bin/env bash
# 停止 core + mock + proxy。按 pid 文件先杀，杀不干净的用 pgrep 兜底。
set -u
TDAI_HOME="$HOME/.tdai-lab"

kill_by_pidfile() {
  local pidfile="$1" label="$2"
  if [[ -s "$pidfile" ]]; then
    local pid; pid=$(cat "$pidfile")
    if kill -0 "$pid" 2>/dev/null; then
      echo "→ 停 $label (pid=$pid)"
      kill "$pid" 2>/dev/null || true
      sleep 1
      kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
    else
      echo "✓ $label 已不在（pid=$pid 无效）"
    fi
    rm -f "$pidfile"
  else
    echo "✓ $label 无 pid 文件"
  fi
}

kill_by_pattern() {
  local pattern="$1" label="$2"
  local pids
  pids=$(pgrep -af "$pattern" | awk '{print $1}' | tr '\n' ' ')
  if [[ -n "${pids// /}" ]]; then
    echo "→ 兜底杀 $label: $pids"
    # shellcheck disable=SC2086
    kill $pids 2>/dev/null || true
    sleep 1
    # shellcheck disable=SC2086
    kill -9 $pids 2>/dev/null || true
  fi
}

kill_by_pidfile "$TDAI_HOME/proxy.pid" proxy
kill_by_pidfile "$TDAI_HOME/mock.pid"  mock
kill_by_pidfile "$TDAI_HOME/core.pid"  core

# 兜底：如果 pid 文件对不上（比如手工起过），按命令行特征清一遍
kill_by_pattern "node.*--import tsx/esm.*src/index.ts.*proxy.yaml" proxy
kill_by_pattern "mock-upstream.mjs" mock
kill_by_pattern "tsx.*gateway/server.ts" core

echo
echo "─── 剩余相关进程（应为空）───"
ps -ef | grep -E "tsx.*gateway/server|mock-upstream|--import tsx/esm.*src/index" | grep -v grep || echo "无残留"
SH
chmod +x ~/.tdai-lab/stop-all.sh
```

**Step 4：写 `~/.tdai-lab/status-all.sh`**（一眼看清三件是不是都活着）

```sh
cat > ~/.tdai-lab/status-all.sh <<'SH'
#!/usr/bin/env bash
# 打印 core/mock/proxy 的进程 + 端口 + 健康状态。
# 端口探活统一用 curl（有些精简 shell 里没 ss/netstat）
set -u
TDAI_HOME="$HOME/.tdai-lab"

probe() {
  local url="$1"
  curl -sS -o /dev/null -w "%{http_code}" --max-time 2 "$url" 2>/dev/null || echo 000
}

check() {
  local label="$1" pidfile="$2" pattern="$3" port="$4" health_url="$5"
  local pid=""
  [[ -s "$pidfile" ]] && pid=$(cat "$pidfile")
  local alive="✗"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    alive="✓"
  else
    pid=$(pgrep -af "$pattern" | awk 'NR==1{print $1}')
    [[ -n "$pid" ]] && alive="✓(pattern)"
  fi
  # 端口探活：curl 探根路径，任何 HTTP 响应（含 4xx）都说明端口活着；只有 000 才算死
  local port_code
  port_code=$(probe "http://127.0.0.1:$port/")
  local port_open
  if [[ "$port_code" == "000" ]]; then port_open="✗"; else port_open="✓"; fi
  # 健康：有 health_url 走它，否则用端口探活的结果
  local http_code="$port_code"
  [[ -n "$health_url" ]] && http_code=$(probe "$health_url")
  printf "%-6s alive=%s pid=%-8s port(:%s)=%s http=%s\n" "$label" "$alive" "${pid:-N/A}" "$port" "$port_open" "$http_code"
}

check core  "$TDAI_HOME/core.pid"  "tsx.*gateway/server.ts"                        8420 http://127.0.0.1:8420/health
check mock  "$TDAI_HOME/mock.pid"  "mock-upstream.mjs"                             8199 ""
check proxy "$TDAI_HOME/proxy.pid" "node.*--import tsx/esm.*src/index.ts.*proxy.yaml" 8096 ""
SH
chmod +x ~/.tdai-lab/status-all.sh
```
> ★端口探活用 curl 不用 `ss`：受限环境（如某些容器）里可能没 `ss` / `netstat`；curl 处处有。任何 HTTP 响应（含 404/401）都说明端口活着，只有 curl 自身返 000（连不上）才算死。

**Step 5：日常使用**

```sh
~/.tdai-lab/start-all.sh    # 拉起（幂等，可反复跑）
sleep 10                    # ★冷启动必须等（原因见下）
~/.tdai-lab/status-all.sh   # 看健康——以这个为准
~/.tdai-lab/stop-all.sh     # 全停
```

关掉/切换任意终端窗口都不影响这三个进程——它们的父 pid 会变成 1（init 接管），跟 shell 完全解耦。**注意**：机器重启后**不会自动拉起**，需要手动跑一次 `start-all.sh`；本机容器不支持 systemd（原因见「补充 §8b」），此为已知限制。

> ★★**start-all.sh 输出里的 `core health=000000` 是已知误报，不是故障**。原因：脚本自带的探测在 core fork 后仅 sleep 5s 就 curl `/health`，而实测冷启动 tsx loader 的首次编译要 8~10s 才 listen 端口，所以 `core=000` **必然**出现在 start-all 的输出里。**判定 core 死活以 `status-all.sh`（前置 `sleep 10`）为准**，不要根据 start-all 的 000 就下结论说 core 挂了。如果 status-all 里 core 依然是 000，那才是真挂——去 `tail -50 ~/.tdai-lab/memory-core.log` 看堆栈。

