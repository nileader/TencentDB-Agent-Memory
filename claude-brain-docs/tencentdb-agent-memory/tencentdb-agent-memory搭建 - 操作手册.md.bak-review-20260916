sed -i.bak -E 's|^(\s*url:).*|\1 "http://127.0.0.1:8199"  # ★§4 期间用 mock；§5 需切回 ducky（见 §5.1）|' ~/.tdai-lab/proxy.yaml
grep -E "^\s*url:" ~/.tdai-lab/proxy.yaml   # 校验：应显示 127.0.0.1:8199

# 2. 只重启 proxy（core / mock 保持运行；重启 proxy 让新 upstream 生效）
